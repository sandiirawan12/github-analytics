# GitHub Analytics — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# GitHub Personal Access Token (classic or fine-grained)
# Required scopes (classic): read:user, repo
# Fine-grained: Contents (read), Metadata (read), Pull requests (read), Issues (read)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub username to generate analytics for
GITHUB_USERNAME=sandiirawan12

# Optional: timezone for productive-time calculations (IANA)
# Default: UTC
TIMEZONE=Asia/Jakarta

# Optional: output directory for generated SVG cards
# Default: ./output
OUTPUT_DIR=./output
