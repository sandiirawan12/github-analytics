# GitHub Analytics — Environment Variables
# Copy this file to .env for local runs.
# For GitHub Actions, use repository secret GH_PAT instead (do not commit .env).

# PAT with repo + read:user (needed for private stats + pushing cards)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Account to analyze (usually your GitHub username)
GITHUB_USERNAME=your-username

# Optional overrides (otherwise analytics.config.yml is used)
# TIMEZONE=UTC
# OUTPUT_DIR=./output
